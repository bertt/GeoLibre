{
  "name": "geolibre-mapterhorn",
  "version": "0.1.0",
  "private": true,
  "description": "GeoLibre plugin: live hillshade, vertical exaggeration, 3D terrain, and contours from Mapterhorn global terrain tiles, with an outlier-trimmed elevation statistics readout.",
  "keywords": [
    "geolibre",
    "hillshade",
    "maplibre",
    "maplibre-gl",
    "mapterhorn",
    "plugin",
    "terrain"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build:geolibre": "vite build --config vite.geolibre.config.ts",
    "package:geolibre": "npm run build:geolibre && node scripts/package-geolibre-plugin.mjs",
    "install:geolibre": "npm run build:geolibre && node scripts/install-geolibre-plugin.mjs",
    "serve:geolibre": "node scripts/serve-geolibre-plugin.mjs",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "globals": "^17.0.0",
    "maplibre-gl": "^5.24.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "maplibre-gl": ">=3.0.0"
  }
}
